# Gateway and all four runtime services use Spring Boot's native Sentinel binding.
# Inject these variables only in Sentinel deployments. Local compose keeps REDIS_HOST/REDIS_PORT.
SPRING_REDIS_SENTINEL_MASTER=clubmaster
SPRING_REDIS_SENTINEL_NODES=sentinel-1:26379,sentinel-2:26379,sentinel-3:26379
SPRING_REDIS_PASSWORD=
SPRING_REDIS_SENTINEL_PASSWORD=
